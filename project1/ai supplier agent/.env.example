# Copy this file to .env (in this folder OR the folder above it). Never commit .env.
# Without a key the app still runs end-to-end on the offline mock engine.

# Course key (MGT 409): gpt-6-luna via Portkey
PORTKEY_API_KEY=

# Optional settings
# MODEL_NAME=gpt-6-luna
# LLM_MODE=auto              # auto | live | mock
# DATASET=sample             # folder under data/ (product_spec.md + emails.json + policy.json)
# REASONING_EFFORT=low       # only if your model supports it; unset = model default
# WEBHOOK_SECRET=whsec_...   # Svix-style secret; a local-dev secret is used when unset
# PORT=8000
