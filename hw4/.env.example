# Copy this file to `.env` in this folder and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.
# The backend reads hw4/.env if present, otherwise the repository root .env.

# ─── Required ────────────────────────────────────────────────────────────────

# Portkey API key. Routes model calls to gpt-5.6-luna through Portkey's
# OpenAI-compatible endpoint. Without this the chat returns 503 and says so;
# the rest of the site works normally.
PORTKEY_API_KEY=your-portkey-api-key-here


# ─── Recommended ─────────────────────────────────────────────────────────────

# Signs the session cookie. Any long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is generated at startup: still secure, but every
# restart invalidates all sessions and logs everyone out.
JWT_SECRET=replace-with-a-long-random-string


# ─── Optional ────────────────────────────────────────────────────────────────

# Where password-reset links point. The default suits local development.
FRONTEND_URL=http://localhost:5190
