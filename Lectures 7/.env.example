# Copy to .env and fill in a real key. Never commit .env.
#
# The backend loads BOTH of these, in order, so the key can live either here in
# Lecture 7/ or one level up in MGT409/ (shared across lectures):
#   Lectures 7/.env
#   MGT409/.env

# Portkey gateway key, used for all OpenAI model calls.
PORTKEY_API_KEY=pk-your-portkey-key-here

# Optional overrides — the defaults are what the lecture uses.
# COURSE_AGENT_MODEL=gpt-5.6-sol
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional, frontend only: where the React app looks for the API.
# VITE_API_BASE=http://127.0.0.1:8000
