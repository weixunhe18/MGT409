# Copy this file to `.env` in this folder and fill in the real value.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.
# The backend reads hw5/.env if present, otherwise the repository root .env.

# Portkey API key. Every agent calls gpt-5.6-luna through Portkey's
# OpenAI-compatible endpoint.
PORTKEY_API_KEY=your-portkey-api-key-here
